<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework> 
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<RootNamespace>Signum</RootNamespace>
		<OutputType>Library</OutputType>
		<NoWarn>8618</NoWarn>
		<UserSecretsId>4236b9c6-a674-4f4f-8ce6-6a591967257e</UserSecretsId>
		<TSGeneratorDisabled>false</TSGeneratorDisabled>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <TypeScriptCompile Remove="node_modules\**" />
	</ItemGroup>


	<ItemGroup>
		<EmbeddedResource Include="Engine\Sync\Postgres\versioning_function.sql" />
		<EmbeddedResource Include="Engine\Sync\Postgres\versioning_function_nochecks.sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<!-- Transitive pin: Microsoft.Data.SqlClient 7.1.1 pulls System.Security.Cryptography.Pkcs 9.0.18,
		     vulnerable to GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 (CVE-2026-84008 / CVE-2026-70162).
		     Remove once SqlClient references a patched version (>= 9.0.21 / 10.0.13). -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Pgvector" Version="0.3.2" />
		<PackageReference Include="Signum.Analyzer" Version="3.2.0" />
		<PackageReference Include="Signum.MSBuildTask" Version="10.0.0" />
		<PackageReference Include="Signum.TSGenerator" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Signum.Utilities\Signum.Utilities.csproj" />
	</ItemGroup>

</Project>
